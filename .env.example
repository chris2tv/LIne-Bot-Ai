# Copy to .env.local for local dev. In production set these in Vercel → Settings → Environment Variables.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
# Google Sheet → File → Share → Publish to web → CSV
SHEET_CSV_URL=

# Optional: admin alerts when the bot replies the default message (skipped if blank)
# LINE group ID (starts with C) — add the bot to the admin group; it replies with the ID
ADMIN_LINE_GROUP_ID=
# Apps Script web app URL (ends in /exec) from scripts/unanswered-sheet.gs
UNANSWERED_SHEET_URL=
# Same value as the SECRET script property in that Apps Script
UNANSWERED_SHEET_SECRET=
